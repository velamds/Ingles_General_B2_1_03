ack": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn9le03ob01re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": "Find out about an entrepreneur.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn9le03ob01re2aud01", "coverimg": "engenn9le03ob01re2img05.jpg", "images": [{"image": "engenn9le03ob01re2img05.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn9le03ob01re2img05.jpg", "text": "<span class=\"strong\">Kristi</span>: Ms. Elison? Do you have a minute?<br>\n<span class=\"strong\">Janet</span>: Kristi, yes. Come in. Have a seat. What's on your mind?<br>\n<span class=\"strong\">Kristi</span>: You mentioned that you started Polygon as a start-up company. How did you get into PR?<br>\n<span class=\"strong\">Janet</span>: Well, I began in non-profit work. I just happened to fall into PR work there, but I didn't really know I was working in that area when I started. I just enjoyed what I was doing, and it was always what I gravitated toward.<br>", "time": "100", "id": 1}, {"image": "engenn9le03ob01re2img07.jpg", "text": "<span class=\"strong\">Kristi</span>: Why did you want to strike out on your own and become an entrepreneur?<br>\n<span class=\"strong\">Janet</span>: When I was finishing up grad school, I was interviewing in Chicago. I was hired by a company there to work in communications and marketing. While I was working at the company, I started to get referrals. That's why I decided to open up my own firm.<br>\n<span class=\"strong\">Kristi</span>: What did you face in the way of challenges to have your own PR firm?<br>\n<span class=\"strong\">Janet</span>: The referrals moved me away from B2B where the monetary business is, so if I was going to have more financial stability, I knew I would have to build a client list that was going to provide that.", "time": "27800", "id": 2}, {"image": "engenn9le03ob01re2img06.jpg", "text": "<span class=\"strong\">Kristi</span>: How did you feel about that?<br>\n<span class=\"strong\">Janet</span>: It was difficult. Although I could ask for whatever amount of money I wanted to, I was competing with other firms. So, when I was pitching clients, I sometimes had to lower my rates, which wasn't good financially. I realized early on that I needed to raise capital if I wanted to continue to operate my firm.<br>\n<span class=\"strong\">Kristi</span>: What else do you need to build a firm and keep it going other than capital?<br>\n<span class=\"strong\">Janet</span>: First of all, you have to have talent.  You need to ask yourself a few questions.  Have you got your niche covered? What kind of media are clients currently looking for? How much do you know about those areas? Do your clients need publicity? Are they looking for crisis management? You have to be honest with yourself. You need to know your strengths.", "time": "62300", "id": 3}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}