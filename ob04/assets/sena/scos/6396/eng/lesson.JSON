pe": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn9le03ob04re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Tell your partner about your career ideas. ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn9le03ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Kristi</span>: I have another question to ask you ...  but it may sound silly.\n<br><span class=\"strong\">Bianca</span>: There are no silly questions.\n<br><span class=\"strong\">Kristi</span>: When I'm including my skills on my master r\u00e9sum\u00e9 ... how do I know if it's a hard skill ... or a soft skill? I always get them confused.<br/>\n<span class=\"strong\">Bianca</span>: Hard skills are concrete, and easily measured. They consist of factual knowledge, things you learned at school ... or during other formal training. These include skills specific to a particular occupation ...  such as those involved in planning and collecting data ... for urban planners, ...  or the ability to use specific programs ... for a graphic designer.", "id": 1, "time": "100", "image": "engenn9le03ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Kristi</span>: So me being able to use inPrint is a hard skill then?\n<br><span class=\"strong\">Bianca</span>: Correct. Proficiency with inPrint could be considered a hard skill for a UX/UI designer, marketing coordinator or even an editorial assistant. Soft skills, on the other hand, are somewhat less tangible and can be acquired in various areas of your life, from school, work, volunteering and extracurricular activities.", "id": 2, "time": "48000", "image": "engenn9le03ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Kristi</span>: So a skill I used while interning as a copy editor ...  that I could use if I became a webmaster?\n<br><span class=\"strong\">Bianca</span>: Yes, because soft skills include interpersonal and communication skills, organization, problem solving, leadership, creativity, initiative, professionalism etc. ... These skills are often deemed transferable skills ...  because you can transfer them from one job to another and all employers, regardless ... of industry or field, look for a range of soft skills in potential employees.", "id": 3, "time": "82000", "image": "engenn9le03ob04re2img06.jpg"}, {"text": "<span class=\"strong\">Kristi</span>: So you're saying soft skills are less technical and more social ... like they have to do with how you communicate and interact with people?\n<br><span class=\"strong\">Bianca</span>: Exactly!\n<br><span class=\"strong\">Kristi</span>: Thanks for clarifying the difference between the two. It helps a lot!\n<br><span class=\"strong\">Bianca</span>: Anytime, Kristi.", "id": 4, "time": "124000", "image": "engenn9le03ob04re2img07.jpg"}], "audiosrc": "engenn9le03ob04re2aud01", "coverimg": "engenn9le03ob04re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}